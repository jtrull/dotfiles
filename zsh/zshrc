# My .zshenv disables global rc files in order to skip OS X's default
# /etc/zprofile.  But I still want /etc/zshrc.
if [[ ! -o globalrcs && -f /etc/zshrc ]]; then
    source /etc/zshrc
fi

_has() {
    return $(whence $1 > /dev/null)
}

alias vim='nvim'
export EDITOR='nvim'
export VISUAL=$EDITOR
export PAGER='less'

setopt \
    auto_pushd \
    append_history \
    auto_name_dirs \
    hist_ignore_space \
    magic_equal_subst

# History
HISTFILE=~/.zshhistory
HISTSIZE=3000
SAVEHIST=3000

# Pure prompt settings
PURE_GIT_DOWN_ARROW='↓'
PURE_GIT_UP_ARROW='↑'

# Homebrew settings.
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

# Plugins
if [[ -d /opt/homebrew/opt/antidote ]]; then
  source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
fi

antidote load

autoload -Uz promptinit && promptinit && prompt pure

# Local bin
path=($HOME/.local/bin $path)

# FZF
if _has fzf; then
  source <(fzf --zsh);
  if _has rg; then
    export FZF_DEFAULT_COMMAND='rg --color=never --files'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
fi

# ASDF
export ASDF_DATA_DIR="$HOME/.asdf"
path=($ASDF_DATA_DIR/shims $path)

# VI mode
bindkey -v
# Load additional functions for vi mode line editing
autoload -U select-bracketed
zle -N select-bracketed
for m in visual viopp; do
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do
    bindkey -M $m $c select-bracketed
  done
done
autoload -U select-quoted
zle -N select-quoted
for m in visual viopp; do
  for c in {a,i}{\',\",\`}; do
    bindkey -M $m $c select-quoted
  done
done
autoload -Uz surround
zle -N delete-surround surround
zle -N add-surround surround
zle -N change-surround surround
bindkey -a cs change-surround
bindkey -a ds delete-surround
bindkey -a ys add-surround
bindkey -M visual S add-surround
# Use space in normal mode to edit command line in vim
autoload edit-command-line
zle -N edit-command-line
bindkey -M vicmd ' ' edit-command-line

# Initialize completions.
fpath=($fpath $HOME/.local/share/zsh/completions) # Additional completions
autoload -Uz compinit
# Only recache once per day.
if [[ -f ~/.zcompdump(N.mh+24) ]]; then
  compinit
fi
compinit -C

# ls colors
export CLICOLOR=1
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# Aliases
alias d='docker'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias de='docker exec'
alias dr='docker run'
alias dc='docker compose'
alias dce='docker compose exec'
alias dcr='docker compose run'
function drsh() { docker run -it --rm $* /bin/bash }
function desh() { docker exec -it $* /bin/bash }
function dcrsh() { docker compose run --rm --no-deps $* /bin/bash }
function dcesh() { docker compose exec $* /bin/bash }
alias tf='terraform'

